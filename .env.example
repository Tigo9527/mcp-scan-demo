# 复制为 .env 并按需修改。未设置时使用内置默认值（demo 可直接跑）。
#
# 加载方式：服务启动时自动读取本文件（src/index.ts 顶部 import 'dotenv/config'）。
# 优先级：已存在的环境变量 > .env（dotenv 默认不覆盖），
#         所以部署平台注入的 JWT_SECRET / ADMIN_TOKEN 等永远赢，不会被本文件改掉。
# 作用域：只影响本地开发；公网部署用的是平台注入的环境变量，与本文件无关。
# 注意：.env 已在 .gitignore 中，不会被提交。

# 服务监听
PORT=3000
HOST=0.0.0.0
# 对外基础地址（用于拼接回调 / MCP 端点 URL）
BASE_URL=http://localhost:3000
# 对外可见基础地址（部署在公网/反代后由环境变量覆盖，工具里返回的登录链接会以此拼接）
# 不设置时回退到 BASE_URL
# 注意：部署平台的网关只转发内部 host，服务端无法从请求头推断公网域名，公网部署必须显式设置
PUBLIC_BASE_URL=http://localhost:3000

# JWT 签名密钥（生产环境务必改成随机长字符串）
JWT_SECRET=dev-mcp-demo-secret-change-me

# Admin 管理端令牌（/admin 登录用）
# 本地开发不设置时回退到默认值 dev-admin-change-me；
# 只要对外地址不是 localhost，使用默认令牌会直接返回 503 禁用管理端。
# 公网部署务必注入，例如：ADMIN_TOKEN=xxxx npm start
ADMIN_TOKEN=

# GitHub OAuth 应用凭据（https://github.com/settings/developers）
# 回调地址需填写：http://localhost:3000/auth/github/callback
# 也可以留空，部署后在 Admin 管理端 → GitHub 设置里在线填写（立即生效，无需重启）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 授权范围，默认 read:user user:email
GITHUB_SCOPE=read:user user:email

# 数据落盘目录（用户 / 统计 / 运行时设置）
DATA_DIR=./data
# 设为 0 可完全关闭落盘（纯内存模式）
MCP_DEMO_PERSIST=1

# 存储方言：sqlite（默认）或 mysql。切换到 mysql 时需提供下方 MYSQL_* 连接参数。
STORAGE_DRIVER=sqlite
# MySQL 连接：优先用 MYSQL_URL（完整连接串）；未设置时读各分项。
# MYSQL_URL=mysql://user:pass@127.0.0.1:3306/mcp_demo
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=mcp_demo

# ConfluxScan 只读查询工具（list_cfx_transfers / list_latest_transactions）的 API 基地址。
# 不设置时回退到下方默认值。
#   - list_cfx_transfers 走 Open API（CONFLUXSCAN_API_URL）
#   - list_latest_transactions 走浏览器 API（CONFLUXSCAN_WEB_API_URL）
# 查询 Conflux Core 测试网时改为：https://api-testnet.confluxscan.org
CONFLUXSCAN_API_URL=https://api.confluxscan.org
CONFLUXSCAN_WEB_API_URL=https://www.confluxscan.org
# list_transfers（全网转账流 v1/transfer）的 API 基地址，默认 Conflux Core 测试网。
# 查主网时改为：https://www.confluxscan.org
CONFLUXSCAN_TRANSFER_API_URL=https://testnet.confluxscan.org

# 调用计费（RPC Endpoint 风格的点数账本，见 src/billing.ts）
# 新用户赠送的免费点数（余额初始值），默认 1000
BILLING_FREE_CREDITS=1000
# 未命中定价表的工具回退单价（点数/次），默认 1
BILLING_DEFAULT_COST=1
# 硬计费开关：on（默认）= 余额不足时拦截收费工具（返回 402）；off = 仅统计展示（余额可为负仍放行）
BILLING_ENFORCE=on
